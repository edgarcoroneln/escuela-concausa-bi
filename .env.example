# === FARO — Plantilla de Variables de Entorno ===
# 📋 Copia este archivo a .env y genera tus propias claves
# 🔐 Genera claves seguras con: python3 scripts/generate-keys.py
# 🔒 Nivel de seguridad: 9/10 (CIS Controls v8 compliant)
# 🔄 Rotación recomendada: cada 90 días

# === General ===
ENVIRONMENT=local
PROJECT_NAME=faro-escuela-sensor

# === PostgreSQL ===
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=escuela_concausa_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GENERAR_CON_SCRIPT_20_CARACTERES

# === Airflow ===
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:CAMBIAR_POR_PASSWORD_POSTGRES@db:5432/airflow
AIRFLOW__CORE__FERNET_KEY=GENERAR_CON_SCRIPT_FERNET_KEY
AIRFLOW__WEBSERVER__SECRET_KEY=GENERAR_CON_SCRIPT_32_CARACTERES
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=faro_airflow_admin
_AIRFLOW_WWW_USER_PASSWORD=GENERAR_CON_SCRIPT_20_CARACTERES

# === MLflow ===
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_BACKEND_STORE_URI=postgresql://postgres:CAMBIAR_POR_PASSWORD_POSTGRES@db:5432/mlflow
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts

# === Superset ===
SUPERSET_SECRET_KEY=GENERAR_CON_SCRIPT_32_CARACTERES
SUPERSET_ADMIN_USERNAME=faro_superset_admin
SUPERSET_ADMIN_PASSWORD=GENERAR_CON_SCRIPT_20_CARACTERES
SUPERSET_ADMIN_EMAIL=admin@faro.local

# === FastAPI ===
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# Sello de la imagen que reporta /api/v1/version. `docker compose build` interpola este
# valor como --build-arg GIT_SHA. Normalmente lo pasa el build (GIT_SHA=$(git rev-parse HEAD));
# vacío/ausente => la imagen reporta "dev". No es secreto.
GIT_SHA=

# --- Auth: OAuth2 + JWT (US-402) ---
# JWT_SECRET_KEY: OBLIGATORIO en prod. Genera uno con scripts/generate-keys.py (>=32 chars).
# En local puede quedar vacío (se usa un default inseguro). NUNCA subas el valor real.
JWT_SECRET_KEY=GENERAR_CON_SCRIPT_32_CARACTERES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Credenciales OAuth de Google (las provee la Célula 5 / GCP; dejar vacías en local)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
# Política de rol PROVISIONAL (decisión final = Edgar/PO). CSV de correos con rol analista; vacío => todos ciudadano.
ANALISTA_EMAILS=
# RBAC de lectura (US-403). true => gold/predicciones/agente públicos (demo sin login mientras el
# OAuth Google no esté operativo). Poner en false cuando C5 entregue credenciales: la lectura pasa a
# exigir sesión `ciudadano`. El admin SIEMPRE exige `analista`, sin importar este flag.
AUTH_LECTURA_PUBLICA=true

# --- Hardening HTTP (US-404) ---
# CORS: orígenes permitidos (CSV). C5 añade aquí la URL del frontend/deploy. Vacío => sin CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:8501,http://localhost:8088
# Rate limiting por IP (formato de la librería `limits`: "<n>/<periodo>").
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute

# Ejecutor SQL read-only del agente (US-404 / BUG-025). DSN de un rol PostgreSQL con SOLO SELECT
# sobre gold.* (lo provisiona C5 en Secret Manager). Vacío => el ejecutor no se cablea (agente degrada).
DATABASE_URL_READ_ONLY=
AGENTE_SQL_TIMEOUT_MS=30000
# LLM del agente (BUG-025 / P-13). Adaptador Anthropic (src/agente/llm.py). Vacío => el agente NO
# llama al LLM: degrada seguro y CI/local no consumen la API. La provisiona C5 en Secret Manager.
ANTHROPIC_API_KEY=
# Config NO secreta del LLM (opcional; si se omiten valen los defaults del adaptador).
AGENTE_MODELO=claude-sonnet-5
AGENTE_MAX_TOKENS=2048
AGENTE_TIMEOUT_S=30

# === ChromaDB (Agente RAG) ===
CHROMA_HOST=chromadb
CHROMA_PORT=8000
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# === GCP (para producción, dejar vacío en local) ===
GCP_PROJECT_ID=
GCP_REGION=us-central1

# === INSTRUCCIONES DE SEGURIDAD ===
# 1. NO uses passwords triviales como "admin123"
# 2. EJECUTA: python3 scripts/generate-keys.py
# 3. COPIA las claves generadas a este archivo (.env)
# 4. NUNCA compartas tus credenciales con otros
# 5. ROTA tus passwords cada 90 días
# 6. Este archivo .env NO debe ir a git (está en .gitignore)
