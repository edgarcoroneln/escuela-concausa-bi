# García, 2026-09-03 — guia-ambiente-local/configuracion.env, ya versionado).
*.env
!.env.example
*.pem
*.key
credentials.json
credentials.yaml
credentials.yml
secrets/
secrets.json
secrets.yaml
secrets.yml
service-account*.json

